<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MailClient</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AssemblyName>Dispatch</AssemblyName>
    <Product>Dispatch</Product>
    <AssemblyTitle>Dispatch</AssemblyTitle>
    <!-- Custom entry point (Program.cs) for single-instance activation. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>MailClient.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="MailKit" Version="4.13.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.DirectML" Version="0.14.1" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\ai-models.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\app-icon-32.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Auto-incrementing build number. Bumped once per compiling build (skipped for design-time
       builds), persisted to BuildNumber.txt, and embedded as an [AssemblyMetadata("BuildNumber", n)]
       attribute read at runtime by MailClient.BuildInfo. -->
  <Target Name="SetBuildNumber" BeforeTargets="CoreGenerateAssemblyInfo;GetAssemblyAttributes"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true'">
    <PropertyGroup>
      <_BuildNumberFile>$(MSBuildProjectDirectory)\BuildNumber.txt</_BuildNumberFile>
    </PropertyGroup>
    <WriteLinesToFile Condition="!Exists('$(_BuildNumberFile)')" File="$(_BuildNumberFile)" Lines="0" Overwrite="true" />
    <ReadLinesFromFile File="$(_BuildNumberFile)">
      <Output TaskParameter="Lines" ItemName="_BuildNumberLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_CurrentBuildNumber>@(_BuildNumberLines)</_CurrentBuildNumber>
      <_CurrentBuildNumber Condition="'$(_CurrentBuildNumber)' == ''">0</_CurrentBuildNumber>
      <BuildNumber>$([MSBuild]::Add($(_CurrentBuildNumber), 1))</BuildNumber>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BuildNumberFile)" Lines="$(BuildNumber)" Overwrite="true" />
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildNumber</_Parameter1>
        <_Parameter2>$(BuildNumber)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
    <Message Importance="high" Text="Build number: $(BuildNumber)" />
  </Target>

</Project>

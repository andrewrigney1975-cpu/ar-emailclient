<Window
    x:Class="MailClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MailClient.Converters"
    xmlns:models="using:MailClient.Models">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:DoneToOpacityConverter x:Key="DoneOpacity" />
            <conv:ReadToOpacityConverter x:Key="ReadOpacity" />
            <conv:ReadToWeightConverter x:Key="ReadWeight" />
            <conv:ReadToDotBrushConverter x:Key="ReadDot" />
            <conv:SelectionToBrushConverter x:Key="SelBrush" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource ControlFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInset" Width="0" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/app-icon-32.png" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock x:Name="AppTitleText" Text="Dispatch" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusInline" Text="{Binding StatusText}" FontSize="12" Opacity="0.6"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <Button Grid.Column="1" x:Name="CalendarToggleButton" Click="CalendarToggle_Click"
                    ToolTipService.ToolTip="Show / hide calendar sidebar" AutomationProperties.Name="Toggle calendar sidebar"
                    Background="Transparent" BorderThickness="0" CornerRadius="0"
                    MinWidth="0" MinHeight="0" Padding="0" Width="46" VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                <FontIcon Glyph="&#xE8A0;" FontSize="14" VerticalAlignment="Center" />
            </Button>
        </Grid>

        <!-- Body: activity bar | rail | list | reading pane -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition x:Name="RailColumn" Width="280" MinWidth="200" MaxWidth="460" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="ListColumn" Width="380" MinWidth="280" MaxWidth="620" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition x:Name="CalendarSplitterColumn" Width="0" />
                <ColumnDefinition x:Name="CalendarColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Activity bar -->
            <Grid Grid.Column="0" Background="{ThemeResource ControlFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Spacing="4" Padding="4,8">
                    <Button x:Name="ComposeButton" Style="{StaticResource ActivityBarButtonStyle}"
                            Click="ComposeButton_Click" ToolTipService.ToolTip="New message"
                            AutomationProperties.Name="New message">
                        <FontIcon Glyph="&#xE70F;" FontSize="18" />
                    </Button>
                    <Button x:Name="RefreshButton" Style="{StaticResource ActivityBarButtonStyle}"
                            Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh this folder"
                            AutomationProperties.Name="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="18" />
                    </Button>
                    <Button x:Name="SyncButton" Style="{StaticResource ActivityBarButtonStyle}"
                            Click="SyncButton_Click" ToolTipService.ToolTip="Sync all accounts"
                            AutomationProperties.Name="Sync">
                        <Grid>
                            <FontIcon Glyph="&#xE895;" FontSize="18" />
                            <ProgressRing x:Name="SyncRing" IsActive="False" Visibility="Collapsed"
                                          Width="18" Height="18" />
                        </Grid>
                    </Button>
                    <Button x:Name="CalendarModeButton" Style="{StaticResource ActivityBarButtonStyle}"
                            Click="CalendarMode_Click" ToolTipService.ToolTip="Calendar"
                            AutomationProperties.Name="Calendar">
                        <FontIcon Glyph="&#xE787;" FontSize="18" />
                    </Button>
                    <Button x:Name="BriefingButton" Style="{StaticResource ActivityBarButtonStyle}"
                            Click="BriefingButton_Click" ToolTipService.ToolTip="Today &amp; weekly briefings"
                            AutomationProperties.Name="Briefings">
                        <FontIcon Glyph="&#xE8F1;" FontSize="18" />
                    </Button>
                    <Button x:Name="AiButton" Style="{StaticResource ActivityBarButtonStyle}"
                            Click="AiButton_Click" ToolTipService.ToolTip="On-device AI"
                            AutomationProperties.Name="AI settings">
                        <FontIcon Glyph="&#xE945;" FontSize="18" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="4" Padding="4,8">
                    <Button x:Name="AddAccountButton" Style="{StaticResource ActivityBarButtonStyle}"
                            Click="AddAccountButton_Click" ToolTipService.ToolTip="Add account"
                            AutomationProperties.Name="Add account">
                        <FontIcon Glyph="&#xE710;" FontSize="18" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Rail: account + folder tree -->
            <Grid Grid.Column="1" Background="{ThemeResource ControlFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Mailboxes" FontWeight="SemiBold" Margin="12,10,12,4" />

                <TreeView Grid.Row="1" x:Name="MailTree" Margin="4,0,4,4" SelectionMode="Single"
                          ItemInvoked="MailTree_ItemInvoked"
                          RightTapped="MailTree_RightTapped">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TreeViewItem ItemsSource="{Binding Children}"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="2,3"
                                            HorizontalAlignment="Stretch" Background="Transparent"
                                            CanDrag="True" DragStarting="FolderRow_DragStarting"
                                            DropCompleted="Row_DropCompleted" Tapped="FolderRow_Tapped"
                                            AllowDrop="True" DragEnter="FolderRow_DragOver"
                                            DragOver="FolderRow_DragOver" Drop="FolderRow_Drop">
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="14" FontFamily="Segoe Fluent Icons"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8"
                                            Padding="6,0" MinWidth="18" Height="16" VerticalAlignment="Center"
                                            Visibility="{Binding UnreadCount, Converter={StaticResource CountToVis}}">
                                        <TextBlock Text="{Binding UnreadCount}" FontSize="10"
                                                   Foreground="White" HorizontalAlignment="Center" />
                                    </Border>
                                    <ProgressRing IsActive="{Binding IsConnecting}" Width="14" Height="14"
                                                  Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <StackPanel Grid.Row="1" x:Name="EmptyRailHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="8" Padding="20" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE715;" FontSize="32" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Text="No accounts yet" Opacity="0.7" HorizontalAlignment="Center" />
                    <Button Content="Add an account" Click="AddAccountButton_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Rectangle Grid.Column="2" x:Name="RailSplitter" Width="6" HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Message list -->
            <Grid Grid.Column="3" x:Name="MailListPane" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Padding="12,8" Spacing="6" BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding FolderTitle}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Click="MarkAllRead_Click" ToolTipService.ToolTip="Mark all as read"
                                Padding="6,2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8FB;" FontSize="12" />
                                <TextBlock Text="Mark all read" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <ProgressRing Grid.Column="2" IsActive="{Binding IsBusy}" Width="16" Height="16" />
                    </Grid>
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search mail" QueryIcon="Find"
                                    QuerySubmitted="SearchBox_QuerySubmitted" TextChanged="SearchBox_TextChanged" />
                </StackPanel>

                <TreeView Grid.Row="1" x:Name="MessageTree" SelectionMode="Single"
                          ItemInvoked="MessageTree_ItemInvoked" RightTapped="MessageTree_RightTapped"
                          SelectionChanged="MessageTree_SelectionChanged"
                          AutomationProperties.Name="Messages">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TreeViewItem ItemsSource="{Binding Children}"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Background="Transparent" Padding="2,4,12,4" HorizontalAlignment="Stretch"
                                      CanDrag="True" DragStarting="MessageRow_DragStarting"
                                      DropCompleted="Row_DropCompleted"
                                      Tapped="MessageRow_Tapped">
                                    <Border CornerRadius="4" IsHitTestVisible="False" Margin="-2,-2,-8,-2"
                                            Background="{Binding IsSelected, Converter={StaticResource SelBrush}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}">
                                        <FontIcon Glyph="&#xE8BC;" FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                                  Visibility="{Binding IsThread, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8"
                                                Padding="6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CountLabel}" FontSize="10" Opacity="0.7" />
                                        </Border>
                                    </StackPanel>

                                    <Grid ColumnSpacing="8" Visibility="{Binding IsMessage, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top" Margin="0,4,0,0"
                                                 Fill="{Binding Row.IsRead, Converter={StaticResource ReadDot}}" />
                                        <StackPanel Grid.Column="1" Spacing="2"
                                                    Opacity="{Binding Row.IsRead, Converter={StaticResource ReadOpacity}}">
                                            <TextBlock Text="{Binding Row.From}"
                                                       FontWeight="{Binding Row.IsRead, Converter={StaticResource ReadWeight}}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Row.SubjectDisplay}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Row.Preview}" FontSize="11" Opacity="0.6" MaxLines="1"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                            <TextBlock Text="{Binding Row.DateDisplay}" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="#D13438"
                                                          Visibility="{Binding Row.IsHighPriority, Converter={StaticResource BoolToVis}}" />
                                                <FontIcon Glyph="&#xE7C1;" FontSize="11"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                          Visibility="{Binding Row.IsFlagged, Converter={StaticResource BoolToVis}}" />
                                                <FontIcon Glyph="&#xE735;" FontSize="11"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                          Visibility="{Binding Row.IsFavourite, Converter={StaticResource BoolToVis}}" />
                                                <FontIcon Glyph="&#xE723;" FontSize="11" Opacity="0.6"
                                                          Visibility="{Binding Row.HasAttachments, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <!-- Calendar mode: the message-list column becomes the event editor / agenda -->
            <Grid Grid.Column="3" x:Name="CalendarEditor" Visibility="Collapsed"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Padding="12,10" Spacing="8"
                            BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <TextBlock x:Name="CalEditorHeading" Text="New event" FontWeight="SemiBold" />
                    <TextBox x:Name="CalTitleBox" Header="Title" PlaceholderText="e.g. Dentist" />
                    <CheckBox x:Name="CalAllDayBox" Content="All day" Checked="CalAllDay_Changed" Unchecked="CalAllDay_Changed" />
                    <CalendarDatePicker x:Name="CalDatePicker" Header="Date" HorizontalAlignment="Stretch" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TimePicker x:Name="CalStartTime" Grid.Column="0" Header="Start" ClockIdentifier="12HourClock" />
                        <ComboBox x:Name="CalDurationBox" Grid.Column="1" Header="Length" HorizontalAlignment="Stretch"
                                  SelectedIndex="2">
                            <ComboBoxItem>15 min</ComboBoxItem>
                            <ComboBoxItem>30 min</ComboBoxItem>
                            <ComboBoxItem>1 hour</ComboBoxItem>
                            <ComboBoxItem>2 hours</ComboBoxItem>
                            <ComboBoxItem>Half day</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <TextBox x:Name="CalNotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CalSaveButton" Content="Save" Style="{ThemeResource AccentButtonStyle}"
                                Click="CalSave_Click" />
                        <Button x:Name="CalDeleteButton" Content="Delete" Click="CalDelete_Click" Visibility="Collapsed" />
                        <Button Content="New" Click="CalNew_Click" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" x:Name="CalAgendaHeader" Padding="12,8,12,4" FontSize="12" Opacity="0.7" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CalAgendaList" Padding="12,0,12,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="CalAgendaItem_Click" Tag="{Binding Id}" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="10,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TimeRangeDisplay}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Rectangle Grid.Column="4" x:Name="ReadingSplitter" Width="6" HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Reading pane -->
            <Grid Grid.Column="5" x:Name="ReadingPane" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid x:Name="ReadingEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE715;" FontSize="40" Opacity="0.35" HorizontalAlignment="Center" />
                        <TextBlock Text="Select a message" Opacity="0.6" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ReadingContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Padding="16,12,16,8" Spacing="2"
                                BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <TextBlock x:Name="SubjectText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="FromText" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                        <TextBlock x:Name="ToText" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                        <TextBlock x:Name="DateText" FontSize="11" Opacity="0.6" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                            <ItemsControl x:Name="MessageTagsList" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="10"
                                                Padding="8,1">
                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding}" FontSize="11" />
                                                <Button Tag="{Binding}" Click="MessageTagRemove_Click" Padding="1"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Remove tag">
                                                    <FontIcon Glyph="&#xE711;" FontSize="9" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Click="MessageTagAdd_Click" Padding="6,1" ToolTipService.ToolTip="Add tag">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE710;" FontSize="10" />
                                    <TextBlock Text="Tag" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SummariseButton" Click="Summarise_Click" Padding="6,1"
                                    Visibility="Collapsed" ToolTipService.ToolTip="Summarise with on-device AI">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE945;" FontSize="10" />
                                    <TextBlock x:Name="SummariseButtonText" Text="Summarise" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SuggestRepliesButton" Click="SuggestReplies_Click" Padding="6,1"
                                    Visibility="Collapsed" ToolTipService.ToolTip="Draft replies with on-device AI">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="10" />
                                    <TextBlock x:Name="SuggestRepliesButtonText" Text="Suggest replies" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border x:Name="SummaryPanel" Visibility="Collapsed" Margin="0,8,0,0" Padding="10,8"
                                CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="AI summary" FontSize="10" Opacity="0.6" />
                                <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="RepliesPanel" Visibility="Collapsed" Spacing="4" Margin="0,8,0,0">
                            <TextBlock Text="Suggested replies — click one to edit and send" FontSize="10" Opacity="0.6" />
                            <ItemsControl x:Name="RepliesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="ReplyChip_Click" Tag="{Binding}" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="10,6">
                                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Padding="12,6" ColumnSpacing="6"
                          BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Click="Reply_Click" ToolTipService.ToolTip="Reply">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8CA;" FontSize="14" /><TextBlock Text="Reply" />
                                </StackPanel>
                            </Button>
                            <Button Click="ReplyAll_Click" ToolTipService.ToolTip="Reply all">
                                <FontIcon Glyph="&#xE8C2;" FontSize="14" />
                            </Button>
                            <Button Click="Forward_Click" ToolTipService.ToolTip="Forward">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72D;" FontSize="14" /><TextBlock Text="Forward" />
                                </StackPanel>
                            </Button>
                            <Button Click="Delete_Click" ToolTipService.ToolTip="Delete">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                            <Button x:Name="FavouriteButton" Click="Favourite_Click"
                                    ToolTipService.ToolTip="Favourite">
                                <FontIcon x:Name="FavouriteGlyph" Glyph="&#xE734;" FontSize="14" />
                            </Button>
                            <Button x:Name="FlagButton" Click="Flag_Click"
                                    ToolTipService.ToolTip="Flag for follow-up">
                                <FontIcon x:Name="FlagGlyph" Glyph="&#xE7C1;" FontSize="14" />
                            </Button>
                            <TextBlock x:Name="PriorityBadge" VerticalAlignment="Center" FontSize="11"
                                       FontWeight="SemiBold" Margin="4,0,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button x:Name="AddToCalendarButton" Click="AddToCalendar_Click" Visibility="Collapsed"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE787;" FontSize="14" />
                                    <TextBlock x:Name="AddToCalendarText" Text="Add to calendar" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LoadImagesButton" Click="LoadImages_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="14" /><TextBlock Text="Load remote images" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AlwaysLoadImagesButton" Click="AlwaysLoadImages_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                    <TextBlock x:Name="AlwaysLoadImagesText" Text="Always load from this sender" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <WebView2 x:Name="BodyWeb" Visibility="Collapsed" />
                        <ScrollViewer x:Name="BodyTextScroller" Visibility="Collapsed" Padding="16">
                            <TextBlock x:Name="BodyText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       FontFamily="Segoe UI" />
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="3" x:Name="AttachmentsBar" Spacing="6" Padding="12,8"
                                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Visibility="Collapsed">
                        <TextBlock Text="Attachments" FontSize="11" Opacity="0.6" />
                        <ItemsControl x:Name="AttachmentsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"
                                            Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE723;" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FileName}" FontSize="12" VerticalAlignment="Center" />
                                            <Button Padding="4" Background="Transparent" BorderThickness="0"
                                                    Tag="{Binding Index}" Click="AttachmentPreview_Click"
                                                    ToolTipService.ToolTip="Preview">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                            </Button>
                                            <Button Padding="4" Background="Transparent" BorderThickness="0"
                                                    Tag="{Binding Index}" Click="AttachmentDownload_Click"
                                                    ToolTipService.ToolTip="Save as…">
                                                <FontIcon Glyph="&#xE896;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- Compose: the reading pane doubles as the composer -->
                <Grid x:Name="ReadingCompose" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Padding="16,12,16,8" Spacing="8"
                                BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <TextBlock x:Name="ComposeHeading" Text="New message" FontWeight="SemiBold" FontSize="14" />
                        <AutoSuggestBox x:Name="ComposeTo" Header="To"
                                        PlaceholderText="recipient@example.com, another@example.com"
                                        TextChanged="RecipientBox_TextChanged"
                                        SuggestionChosen="RecipientBox_SuggestionChosen" />
                        <AutoSuggestBox x:Name="ComposeCc" Header="Cc"
                                        TextChanged="RecipientBox_TextChanged"
                                        SuggestionChosen="RecipientBox_SuggestionChosen" />
                        <TextBox x:Name="ComposeSubject" Header="Subject" />

                        <Grid x:Name="ComposePromptBar" ColumnSpacing="6" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ComposePromptBox" Grid.Column="0" Header="Draft with on-device AI"
                                     PlaceholderText="e.g. reply saying I can do Thursday but not Friday" />
                            <Button x:Name="ComposePromptButton" Grid.Column="1" Click="ComposePrompt_Click"
                                    VerticalAlignment="Bottom" Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE945;" FontSize="12" />
                                    <TextBlock x:Name="ComposePromptButtonText" Text="Draft" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <InfoBar Grid.Row="1" x:Name="ComposeStatus" IsOpen="False" IsClosable="False" Margin="16,8,16,0" />

                    <!-- Formatting toolbar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="2" Padding="14,6"
                                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Button Tag="bold" Click="ComposeCmd_Click" ToolTipService.ToolTip="Bold"
                                Padding="6" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE8DD;" FontSize="14" />
                        </Button>
                        <Button Tag="italic" Click="ComposeCmd_Click" ToolTipService.ToolTip="Italic"
                                Padding="6" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE8DB;" FontSize="14" />
                        </Button>
                        <Button Tag="underline" Click="ComposeCmd_Click" ToolTipService.ToolTip="Underline"
                                Padding="6" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE8DC;" FontSize="14" />
                        </Button>
                        <Rectangle Width="1" Margin="4,2" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button Tag="insertUnorderedList" Click="ComposeCmd_Click" ToolTipService.ToolTip="Bulleted list"
                                Padding="6" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                        </Button>
                        <Button Tag="insertOrderedList" Click="ComposeCmd_Click" ToolTipService.ToolTip="Numbered list"
                                Padding="6" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xF0E4;" FontSize="14" />
                        </Button>
                        <Rectangle Width="1" Margin="4,2" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button Click="ComposeLink_Click" ToolTipService.ToolTip="Insert link"
                                Padding="6" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE71B;" FontSize="14" />
                        </Button>
                        <Button Click="ComposeInsertImage_Click" ToolTipService.ToolTip="Insert image"
                                Padding="6" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xEB9F;" FontSize="14" />
                        </Button>
                        <Button Click="ComposeAttach_Click" ToolTipService.ToolTip="Attach file"
                                Padding="6" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE723;" FontSize="14" />
                        </Button>
                        <Button Tag="removeFormat" Click="ComposeCmd_Click" ToolTipService.ToolTip="Clear formatting"
                                Padding="6" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE75C;" FontSize="14" />
                        </Button>
                        <Rectangle Width="1" Margin="4,2" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ComboBox x:Name="ComposePriority" SelectedIndex="1" MinWidth="86"
                                  ToolTipService.ToolTip="Priority" VerticalAlignment="Center">
                            <ComboBoxItem>Low</ComboBoxItem>
                            <ComboBoxItem>Normal</ComboBoxItem>
                            <ComboBoxItem>High</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <ItemsControl Grid.Row="3" x:Name="ComposeAttachmentsList" Padding="14,4" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"
                                        Padding="8,3">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE723;" FontSize="11" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                        <Button Padding="2" Background="Transparent" BorderThickness="0"
                                                Tag="{Binding Name}" Click="ComposeAttachmentRemove_Click"
                                                ToolTipService.ToolTip="Remove">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WebView2 Grid.Row="4" x:Name="ComposeEditor" Margin="0,4,0,0" />

                    <Grid Grid.Row="5" Padding="16,10" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Discard" Click="ComposeDiscard_Click" />
                            <Button x:Name="ComposeSendButton" Content="Send"
                                    Style="{ThemeResource AccentButtonStyle}" Click="ComposeSend_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- In-app attachment preview (Quick Look) -->
                <Grid x:Name="ReadingPreview" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="10,8" ColumnSpacing="8"
                          BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="PreviewBack_Click" ToolTipService.ToolTip="Back to message">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        </Button>
                        <TextBlock Grid.Column="1" x:Name="PreviewTitle" VerticalAlignment="Center"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Click="PreviewOpenExternal_Click" ToolTipService.ToolTip="Open in default app">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            </Button>
                            <Button Click="PreviewSave_Click" ToolTipService.ToolTip="Save as…">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" x:Name="PreviewImageScroller" Visibility="Collapsed"
                                  ZoomMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                    </ScrollViewer>

                    <WebView2 Grid.Row="1" x:Name="PreviewWeb" Visibility="Collapsed" />

                    <ScrollViewer Grid.Row="1" x:Name="PreviewTextScroller" Visibility="Collapsed" Padding="16">
                        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" x:Name="PreviewFallback" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE723;" FontSize="40" Opacity="0.35" HorizontalAlignment="Center" />
                        <TextBlock x:Name="PreviewFallbackText" Opacity="0.6" HorizontalAlignment="Center" />
                        <Button Content="Open in default app" Click="PreviewOpenExternal_Click"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Calendar mode: the reading pane becomes the calendar grid -->
            <Grid Grid.Column="5" x:Name="CalendarGridPane" Visibility="Collapsed"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="10,8" ColumnSpacing="8"
                      BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Click="CalPrev_Click" ToolTipService.ToolTip="Previous">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        </Button>
                        <Button Content="Today" Click="CalToday_Click" />
                        <Button Click="CalNext_Click" ToolTipService.ToolTip="Next">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="CalRangeLabel" VerticalAlignment="Center"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <SelectorBar Grid.Column="2" x:Name="CalViewTabs" SelectionChanged="CalView_SelectionChanged">
                        <SelectorBarItem Text="Month" />
                        <SelectorBarItem Text="Week" />
                        <SelectorBarItem Text="Work week" />
                        <SelectorBarItem Text="3 day" />
                        <SelectorBarItem Text="Day" />
                    </SelectorBar>
                </Grid>

                <ScrollViewer Grid.Row="1" x:Name="CalScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="CalBody" Padding="8" />
                </ScrollViewer>
            </Grid>

            <Rectangle Grid.Column="6" x:Name="CalendarSplitter" Width="6" HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                       Visibility="Collapsed" />

            <!-- Right rail: calendar -->
            <Grid Grid.Column="7" x:Name="CalendarPane" Visibility="Collapsed"
                  Background="{ThemeResource ControlFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Calendar" FontWeight="SemiBold" Margin="12,10,12,4" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Padding="8,4,8,12">
                        <CalendarView x:Name="RailCalendar" HorizontalAlignment="Stretch"
                                      SelectionMode="Single"
                                      SelectedDatesChanged="RailCalendar_SelectedDatesChanged"
                                      CalendarViewDayItemChanging="RailCalendar_DayItemChanging" />
                        <TextBlock x:Name="CalendarDayHeader" FontWeight="SemiBold" FontSize="12" Margin="4,4,0,0" />
                        <ItemsControl x:Name="CalendarDayEvents">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" Margin="0,0,0,4" ColumnSpacing="6"
                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"
                                          Opacity="{Binding Done, Converter={StaticResource DoneOpacity}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" MinWidth="0" IsChecked="{Binding Done}"
                                                  Tag="{Binding Id}" Click="CalendarEventDone_Click"
                                                  ToolTipService.ToolTip="Mark complete" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Notes}" FontSize="11" Opacity="0.6"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Padding="4" Background="Transparent" BorderThickness="0"
                                                Tag="{Binding Id}" Click="CalendarEventDelete_Click"
                                                ToolTipService.ToolTip="Remove">
                                            <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="CalendarDayEmpty" Text="No events" FontSize="11" Opacity="0.5" Margin="4,0,0,0" />

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6,0,2" />
                        <TextBlock Text="Upcoming" FontWeight="SemiBold" FontSize="12" Margin="4,2,0,0" />
                        <TextBlock x:Name="UpcomingEmpty" Text="Nothing scheduled" FontSize="11" Opacity="0.5"
                                   Margin="4,0,0,0" />
                        <ItemsControl x:Name="UpcomingEvents">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="SemiBold"
                                                   Opacity="0.7" Margin="4,0,0,0" />
                                        <ItemsControl ItemsSource="{Binding Events}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="8,5" Margin="0,0,0,3" ColumnSpacing="8"
                                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                          CornerRadius="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" MinWidth="0" IsChecked="{Binding Done}"
                                                                  Tag="{Binding Id}" Click="CalendarEventDone_Click"
                                                                  ToolTipService.ToolTip="Mark complete" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DayDisplay}" FontSize="10" Opacity="0.55" />
                                                            <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Padding="4" Background="Transparent"
                                                                BorderThickness="0" Tag="{Binding Id}"
                                                                Click="CalendarEventDelete_Click"
                                                                ToolTipService.ToolTip="Remove">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
